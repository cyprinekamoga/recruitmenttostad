# Copy this file to .env and fill it in. Never commit .env.

# --- Required -------------------------------------------------------------

# 32-byte key that encrypts all applicant data and CVs. Generate with: npm run generate-key
# Keep a copy in a password manager, separate from your backups. If it is lost, the data is lost.
DATA_ENCRYPTION_KEY=

# The public address of the site. Must be https:// in production.
PUBLIC_BASE_URL=https://jobs.example.com

NODE_ENV=production

# --- Your organisation ----------------------------------------------------

COMPANY_NAME=Example Ltd
# Shown to applicants as the contact for seeing, correcting or deleting their data.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# --- Server ---------------------------------------------------------------

PORT=3000
# 127.0.0.1 = only reachable through a reverse proxy on the same machine (recommended).
# Use 0.0.0.0 inside Docker or on platforms that route traffic to the container.
HOST=127.0.0.1
# Number of reverse proxies in front of the app (e.g. 1 for nginx/Caddy/a load balancer).
# Needed so rate limiting sees real visitor IPs. Leave empty if there is no proxy.
TRUST_PROXY=1
# Where the database and encrypted uploads are stored (default: ./data)
# DATA_DIR=/var/lib/recruitment

# --- Data protection ------------------------------------------------------

# Applications are deleted automatically this many days after their last update (0 = never).
RETENTION_DAYS=180
# How long a reference link stays valid.
REFERENCE_LINK_DAYS=14
MAX_UPLOAD_MB=5
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=8
RATE_LIMIT_APPLICATIONS_PER_HOUR=10

# --- Email (optional) -----------------------------------------------------
# Without SMTP settings, reference links are shown in the dashboard for you to send yourself.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Use SMTP_SECURE=true for port 465. SMTP_REQUIRE_TLS refuses to send over an unencrypted connection.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Example Ltd Careers <careers@example.com>"
# Receives "new application" / "reference received" alerts (no applicant details in them).
# NOTIFY_EMAIL=hiring@example.com
