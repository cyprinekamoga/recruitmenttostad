{
  "name": "recruitment-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted recruitment portal: job listings, applications with CV upload and reference requests, with applicant data encrypted at rest.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
