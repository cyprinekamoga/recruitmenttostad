# Last line of defence. This folder holds the app's secret key (.env) and its
# data (data/), so it should never be inside your website's public folder.
# If it ever is, these rules stop Apache/LiteSpeed from handing those files out.
<FilesMatch "^\.(env|git)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 404 /(\.env|\.git|data|node_modules)(/|$)
